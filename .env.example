# Environment Configuration for Carbon-Aware Scheduler
# Copy to .env and customize as needed.

CONFIG_FILE=config.yaml
DB_PATH=data/audit.sqlite
AUTO_SEED=1

# Provider Selection: mock | uk_replay | carbon_aware_sdk | watttime | electricitymaps
PROVIDER=mock

# Live Provider Credentials (optional)
# Carbon Aware SDK (WebApi URL)
# CASDK_URL=http://localhost:5073

# WattTime v3 (Free account supports CAISO_NORTH)
# WATTTIME_USER=your_username
# WATTTIME_PASS=your_password

# Electricity Maps API Token
# EMAPS_TOKEN=your_auth_token
# EMAPS_BASE=https://api.electricitymap.org/v4

# API Security (optional, if set enforces X-API-Key header)
# API_KEY=development-secret-key
